# Sanity environment variables for Zero Point Buy Sell Exchange
# Copy this file to .env.local and fill in real values from manage.sanity.io

NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-06-09

# Optional: read token for previewing draft content
# SANITY_API_READ_TOKEN=sk-your-read-token
